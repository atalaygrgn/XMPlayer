a_hk = esc

a = p    # pause/play
b = .    # frame step
x = m    # mute sound
y = o    # on screen display

up = up        # seek +1min
down = down    # seek -1min
left = left    # seek -5sec
right = right  # seek +5sec

l1 = [     # previous video
l2 = v     # subtitle visibility
r1 = ]     # next video
r2 = j     # subtitle next

start = a  # change aspect ratio
select = q # quit